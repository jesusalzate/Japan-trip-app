# Copia este archivo como ".env.local" y rellena con los datos de tu proyecto de Supabase.
# (Supabase → Project Settings → API). Estas dos claves son públicas (no secretas).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Compatibilidad: si tu proyecto aún usa la clave "anon" clásica (empieza por eyJ...),
# puedes usar este nombre en su lugar:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Solo necesarias para la actualización AUTOMÁTICA diaria del tipo de
# cambio (cron). Sin ellas la app funciona igual; el botón "Actualizar"
# manual del conversor sigue funcionando siempre.
# Supabase → Project Settings → API → "service_role" (¡secreta! nunca la
# pongas con el prefijo NEXT_PUBLIC_ ni la compartas).
SUPABASE_SERVICE_ROLE_KEY=
# Cualquier cadena aleatoria larga que tú elijas; se configura igual en
# Vercel y protege el cron para que solo Vercel pueda dispararlo.
CRON_SECRET=
