# Copia este archivo como ".env.local" y rellena con los datos de tu proyecto de Supabase.
# (Supabase → Project Settings → API). Estas dos claves son públicas (no secretas).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Compatibilidad: si tu proyecto aún usa la clave "anon" clásica (empieza por eyJ...),
# puedes usar este nombre en su lugar:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
